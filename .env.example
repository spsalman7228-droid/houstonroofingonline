# FIREBASE_SERVICE_ACCOUNT_B64: Base64-encoded Firebase Service Account private key JSON.
# Generatable from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# In dev/preview mode, if omitted, the app runs in dual-mode mock preview seamlessly.
FIREBASE_SERVICE_ACCOUNT_B64="eyJuYW1lIjoiZXhhbXBsZSJ9..."

# ADMIN_EMAILS: Comma-separated list of authorized email addresses that automatically
# receive the admin role upon first verified Google sign-in.
ADMIN_EMAILS="admin@example.com,owner@houstonroofingonline.com,spsalman7228@gmail.com"
